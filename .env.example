# For manual setup: copy to .env or /etc/takachiho-boat.env and fill in values.
# configure_telegram.py can import the existing VPS bot token and chat ID instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional forum topic ID; leave empty for the chat's default destination.
TELEGRAM_THREAD_ID=

# Inclusive START times in Japan time. Set BOAT_TO=15:30 to finish by 16:00.
BOAT_DATE=2026-11-20
BOAT_FROM=13:00
BOAT_TO=16:00
REQUEST_TIMEOUT_SECONDS=30

# Forward results to pttbot's in-memory /boat_history cache on localhost.
# Must match second_hand_notify. Set 0 to disable; no public port is needed.
BOAT_HISTORY_PORT=8766

# systemd creates this writable directory; local runs can use state/notifications.json.
BOAT_STATE_FILE=/var/lib/takachiho-boat/notifications.json
